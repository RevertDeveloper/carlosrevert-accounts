DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cuenta.carlosrevert.es
DATABASE_URL=postgres://accounts:accounts@localhost:10410/accounts
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
CSRF_TRUSTED_ORIGINS=https://carlosrevert.es,https://juridia.carlosrevert.es,https://clark.carlosrevert.es,https://transcriptor.carlosrevert.es,https://cuenta.carlosrevert.es
CORS_ALLOWED_ORIGINS=https://carlosrevert.es,https://juridia.carlosrevert.es,https://clark.carlosrevert.es,https://transcriptor.carlosrevert.es,https://cuenta.carlosrevert.es
SESSION_COOKIE_DOMAIN=.carlosrevert.es
CSRF_COOKIE_DOMAIN=.carlosrevert.es
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@carlosrevert.es
INTERNAL_SERVICE_SECRET=replace-with-an-internal-secret
